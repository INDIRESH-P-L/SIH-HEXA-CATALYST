# ══════════════════════════════════════════════════════════════════════════════
#  AI-Enabled Skill Intelligence Platform — environment template
#  Copy to backend/.env and fill in. NEVER commit the filled file.
# ══════════════════════════════════════════════════════════════════════════════

APP_ENV=dev
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── DATA SEAM ─────────────────────────────────────────────────────────────────
# local PostgreSQL (port 5434)
DB_URL=postgresql+asyncpg://sip:sip@localhost:5434/sip
#
# Supabase Supavisor SESSION mode (port 5432) — recommended for a laptop demo.
# Direct db.<ref>.supabase.co:5432 is IPv6-only and will time out on most networks.
# DB_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase Supavisor TRANSACTION mode (port 6543) — the app auto-switches to
# NullPool + statement_cache_size=0 when it sees port 6543.
# DB_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_ECHO=false

# ── AUTH SEAM ─────────────────────────────────────────────────────────────────
# local    → FastAPI issues HS256 JWTs against the auth.users shim table
# supabase → register/login proxied to Supabase Auth (GoTrue); JWTs verified
#            with SUPABASE_JWT_SECRET. Token verification is ONE function either way.
AUTH_MODE=local
LOCAL_JWT_SECRET=change-me-to-a-long-random-string-before-any-shared-demo
LOCAL_JWT_ISSUER=sip-local
LOCAL_JWT_TTL_MIN=720

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── STORAGE SEAM ──────────────────────────────────────────────────────────────
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_STORAGE_BUCKET=materials
MAX_UPLOAD_MB=10

# ── CATALOGUE SEAM ────────────────────────────────────────────────────────────
# mock → the separate FastAPI service on :8001 (this prototype)
# igot → raises NotConfiguredError. Official iGOT Karmayogi API access requires
#        authorised credentials from the Capacity Building Commission.
CATALOGUE_PROVIDER=mock
MOCK_CATALOGUE_URL=http://localhost:8001
MOCK_API_KEY=sih-2026-mock-key
CATALOGUE_TIMEOUT_S=10
CATALOGUE_BREAKER_THRESHOLD=3
CATALOGUE_BREAKER_COOLDOWN_S=30

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
# Leave GROQ_API_KEY empty to run fully offline: every AI feature falls back to
# its deterministic template and the app keeps working.
GROQ_API_KEY=
LLM_ENABLED=true
LLM_TIMEOUT_S=30
LLM_CACHE_ENABLED=true
MODEL_MCQ=openai/gpt-oss-20b
MODEL_TEXT=llama-3.3-70b-versatile
MODEL_FALLBACK=llama-3.1-8b-instant

# ── EMBEDDINGS (FastEmbed, in-process — Groq has NO embeddings endpoint) ──────
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ── M7 assistant: stretch scope, not built in Round 2 ─────────────────────────
ASSISTANT_ENABLED=true

# ── Supabase free projects pause after 7 days with no API requests ────────────
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL_H=6
